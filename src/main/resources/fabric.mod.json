	"description": "Grow your resources instead of mining them. A fork of funkychicken493's Lazy Crops.",
	"authors": [
		"funkychicken493",
		"griffemi"
	],
	"contact": {
		"homepage": "https://github.com/griffemi/lazycrops",
		"sources": "https://github.com/griffemi/lazycrops"
	},
	"license": "MIT",
